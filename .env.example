# Postory environment. Everything without NEXT_PUBLIC_ is server-only and
# must never be exposed to the browser.

NEXT_PUBLIC_APP_URL=https://postory.lol

# Supabase — database, auth, storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Privy — Google sign-in, bridged to a Supabase session (no wallets)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# GitHub Models — all text (OpenAI-compatible chat completions).
# Use a fine-grained GitHub token with only the "Models: read" permission.
GITHUB_MODELS_TOKEN=
# GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com
# GITHUB_MODELS_MODEL=meta-llama-3-70b-instruct
# GITHUB_MODELS_FAST_MODEL=meta-llama-3-70b-instruct
# GITHUB_MODELS_MAX_TOKENS=3000

# Replicate — images only
REPLICATE_API_TOKEN=
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-1.1-pro

# Nango — OAuth for X, LinkedIn, Threads, Instagram, Facebook, Pinterest.
# Each network is an integration in the Nango dashboard with your own app's
# client id/secret (Nango has no shared apps for these networks).
NANGO_SECRET_KEY=

# Encrypts Bluesky app passwords at rest. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=

# HandyPay — subscriptions. No webhooks: state is read from HandyPay's API.
HANDYPAY_API_KEY=

# Email from Postory's own send-only address via Zoho Mail's HTTPS API
# (Railway blocks SMTP below Pro). Scope: ZohoMail.messages.CREATE.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_FROM="Postory <mail@postory.lol>"
# Emailed sign-up/reset codes; turn on once delivery is confirmed.
AUTH_EMAIL_CODES=on

# Alternative to Zoho: any SMTP mailbox
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Postory <mail@postory.lol>"

# Optional: POST /api/internal/email-test with this token emails the owner
EMAIL_TEST_TOKEN=
# Optional: POST /api/internal/ai-check with this token runs one tiny AI request
AI_CHECK_TOKEN=
