# ----------------------------------------------------------------------------
# Postory environment
# Copy to .env.local for local development. Never commit real values.
# Variables without NEXT_PUBLIC_ are server-only and never reach the browser.
# ----------------------------------------------------------------------------

# Public URL of the app (used for OAuth redirects, email links, metadata)
NEXT_PUBLIC_APP_URL=https://postory.lol

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# LetMePost — social connections and publishing (server-only)
LETMEPOST_API_KEY=

# HandyPay — subscription billing (server-only)
HANDYPAY_API_KEY=

# OpenAI — post generation, adaptation, images (server-only)
OPENAI_API_KEY=

# Resend — transactional email (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Email from Zoho Mail over its HTTPS API (preferred on Railway, which blocks
# SMTP below Pro). Self Client at api-console.zoho.com with scopes
# ZohoMail.messages.CREATE,ZohoMail.accounts.READ; exchange the code for a
# refresh token. ZOHO_ACCOUNT_ID comes from GET https://mail.zoho.com/api/accounts.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_FROM="Postory <mail@postory.lol>"
# Turn on emailed sign-up/reset codes once delivery is confirmed.
AUTH_EMAIL_CODES=

# Email from your own mailbox over SMTP (used instead of Resend when set).
# Zoho Mail with a custom domain: host smtppro.zoho.com (smtppro.zoho.eu /
# .in for those data centers), port 465, user = the full mailbox address,
# password = a Zoho app-specific password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Postory <hello@postory.lol>"

# ----------------------------------------------------------------------------
# Optional
# ----------------------------------------------------------------------------

# Override the OpenAI models Postory uses.
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_IMAGE_MODEL=gpt-image-2

# Point at a self-hosted LetMePost instance instead of https://api.letmepost.dev
# LETMEPOST_API_BASE_URL=

# Override the HandyPay API base URL (defaults to https://api.handypay.me/api)
# HANDYPAY_API_BASE_URL=

# Founder links shown in the site footer (defaults live in lib/site.ts)
# NEXT_PUBLIC_FOUNDER_X_URL=
# NEXT_PUBLIC_CONTACT_EMAIL=

# Local development only: grant a plan without billing so AI features can be
# exercised before HandyPay is wired. Ignored unless NODE_ENV=development.
# POSTORY_DEV_PLAN=pro
